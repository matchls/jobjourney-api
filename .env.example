# Base de données (Neon Postgres)
DATABASE_URL=

# JWT (cookie httpOnly "token")
JWT_SECRET=

# Environnement (development | production) — impacte les options de cookie
NODE_ENV=development

# URL du frontend (utilisée pour CORS et les redirections post-OAuth)
# C'est la SEULE origine de production autorisée : comparaison exacte.
CLIENT_URL=http://localhost:3000

# Previews Vercel autorisées par CORS (voir la section CORS du README).
# Une preview a l'URL https://<projet>-<hash>-<team>.vercel.app : ces deux
# variables décrivent le projet et la team dont on accepte les previews, et
# rien d'autre. Aucun secret — ces valeurs sont déjà publiques dans l'URL de
# chaque preview.
#
# Les deux sont optionnelles, mais indissociables : si l'une manque, AUCUNE
# preview n'est autorisée (fail-closed) et seul CLIENT_URL passe. Il n'existe
# volontairement aucune règle *.vercel.app.
#
# À renseigner dans Render pour que les previews du frontend puissent appeler
# l'API. Inutile en local.
CORS_VERCEL_PROJECT=
CORS_VERCEL_TEAM=

# Google OAuth (GET /auth/google, GET /auth/google/callback)
# Sans ces 3 variables, les routes Google échouent proprement mais l'auth
# email (register/login/logout/me) continue de fonctionner normalement.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production attendue : https://jobjourney-api.onrender.com/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Extraction IA d'une offre (POST /applications/parse-offer)
# Clé Groq, exclusivement côté serveur : elle n'est jamais envoyée au
# navigateur, jamais loguée, jamais renvoyée dans une erreur. Sans cette
# variable, le serveur démarre normalement et toutes les routes manuelles
# fonctionnent ; seul /applications/parse-offer répond 503
# (extraction_not_configured). La saisie manuelle d'une candidature reste
# donc toujours possible.
GROQ_API_KEY=

# Modèle utilisé pour l'extraction. Optionnel : sans valeur, le défaut du code
# s'applique (openai/gpt-oss-120b). Attention, seuls certains modèles Groq
# supportent le strict mode des structured outputs — voir
# https://console.groq.com/docs/structured-outputs
GROQ_MODEL=

# Timeout de l'appel Groq en millisecondes. Optionnel (défaut 20000, plafonné
# à 60000).
GROQ_TIMEOUT_MS=

# Import de candidatures par agent (POST /agent/applications)
# Secret (pepper) utilisé pour le HMAC-SHA-256 des clés API agent — jamais le
# même secret que JWT_SECRET. Sans cette variable, le serveur démarre
# normalement mais les routes /agent/* répondent 503 (erreur de config).
AGENT_API_KEY_PEPPER=
